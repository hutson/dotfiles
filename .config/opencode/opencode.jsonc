{
	"$schema": "https://opencode.ai/config.json",
	// Supported models available here - https://opencode.ai/go
	// Usage limits - https://opencode.ai/docs/go/#usage-limits
	"agent": {
		//
		// GOAL: A strong reasoning model that specializes in coding with multi-modal support for acessing any required knowledge.
		//
		// Model - https://models.dev/models/xiaomi/mimo-v2.6-pro/
		// Comparison - https://llm-stats.com/models/compare/glm-5.3-vs-mimo-v2.6-pro
		// Leaderboard - https://llm-stats.com/leaderboards/best-ai-for-reasoning
		//
		// - Slightly less good at reasoning/coding compared to GLM-5.3 but at 3.5x cheaper per token.
		// - Multi-model: text, images, video, audio
		//
		"plan": {
			"model": "opencode-go/mimo-v2.6-pro"
		},
		//
		// GOAL: General model specialized in coding with ability to cheaply take a plan, execute it, and leverage tools to validate work.
		//
		// Model - https://models.dev/models/alibaba/qwen3.8-flash/
		// Comparison - https://llm-stats.com/models/compare/deepseek-v4.1-flash-vs-qwen3.8-flash
		// Leaderboard - https://llm-stats.com/leaderboards/best-ai-for-coding
		//
		// - Considered good at coding and tool calling - https://llm-stats.com/leaderboards/best-ai-for-tool-calling
		// - Not as good as DeepSeek, but DeepSeek is not available inside the US/EU region.
		//
		"build": {
			"model": "opencode-go/qwen3.8-flash",
			"reasoningEffort": "medium"
		},
		//
		// GOAL: A strong model that is balanced, not favoring any particular specialty.
		//
		"general": {
			"model": "opencode-go/qwen3.8-flash",
			"reasoningEffort": "medium"
		},
		//
		// GOAL: A fast and cheap model that is still capable of basic reasoning.
		//
		// Model - https://models.dev/models/xiaomi/mimo-v2.6-flash/
		// Comparison - https://llm-stats.com/models/compare/deepseek-v4.1-flash-vs-mimo-v2.6-flash
		//
		// mimo-v2.5 - https://models.dev/models/xiaomi/mimo-v2.5/
		// Comparison - https://llm-stats.com/models/compare/deepseek-v4-flash-0731-vs-mimo-v2.5
		//
		// - ~10% weaker at benchmarks compared to DeepSeek-v4.1 but is 1.9x cheaper
		//
		"explore": {
			"model": "opencode-go/mimo-v2.6-flash"
		},
		"scout": {
			"model": "opencode-go/mimo-v2.6-flash"
		},
		"compaction": {
			"model": "opencode-go/mimo-v2.6-flash"
		},
		"title": {
			"model": "opencode-go/mimo-v2.6-flash"
		},
		"summary": {
			"model": "opencode-go/mimo-v2.6-flash"
		},
		//
		// GOAL: Each reviewer should use a different model and provider than the plan or build agent to provide a review from a different perspective.
		//
		"reviewer-documentation": {
			// https://llm-stats.com/leaderboards/best-ai-for-writing
			"model": "opencode-go/mimo-v2.6-pro"
		},
		"reviewer-go": {
			"model": "opencode-go/glm-5.3-flash",
			"reasoningEffort": "high"
		},
		"reviewer-security": {
			"model": "opencode-go/glm-5.3-flash",
			"reasoningEffort": "max"
		},
		"reviewer-test-design": {
			"model": "opencode-go/glm-5.3-flash",
			"reasoningEffort": "high"
		},
		//
		// GOAL: A strong reasoning model that specializes in coding and writing.
		//
		"study": {
			"model": "opencode-go/glm-5.3-flash",
			"reasoningEffort": "high"
		}
	},
	"autoupdate": false,
	"default_agent": "plan",
	// Disabling `opencode` is required to avoid `opencode` leaking session metadata to their free summary model:
	// - https://github.com/anomalyco/opencode/issues/10416#issuecomment-3795342973
	"disabled_providers": ["opencode"],
	"enabled_providers": ["opencode-go"],
	// TODO: Investigate whether formatters are automatically downloaded. Until then, disable formatters
	// as we want to manage third-party packages ourselves - https://github.com/anomalyco/opencode/issues/22651
	"formatter": false,
	// Documentation mentions LSPs are automatically downloaded when needed. We do not want `opencode`
	// managing third-party packages. Instead `opencode` should use LSP servers that are already
	// pre-installed onto the system - https://opencode.ai/docs/lsp
	// TODO: Look into this behavior to see if we can achieve the desired outcome.
	"lsp": false,
	// General purpose model.
	// Should be replaced by models better tailored to the specific agent/instructions, which affect
	// how much reasoning is required, whether the model needs to be multimodal, and the latency
	// that can be tolerated from the model.
	"model": "opencode-go/mimo-v2.6-flash",
	"share": "disabled",
	// Setting a small model used in the background by `opencode` to summarize session metadata, to
	// avoid `opencode` sending session metadata to their own free summary model:
	// - https://github.com/anomalyco/opencode/issues/10416#issuecomment-3795295704
	// - https://llm-stats.com/models/compare/deepseek-v4-flash-0731-vs-mimo-v2.5
	"small_model": "opencode-go/mimo-v2.6-flash"
}
